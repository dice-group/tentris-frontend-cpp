#!/bin/bash

# Wrapper script for rustc to facilitate fully static linking with enabled proc-macros on alpine
# Source: https://github.com/rust-lang/rust/issues/71651#issuecomment-864265118

crate_name=0

for i in "$@"; do
    if [[ $i == "--crate-name" ]]; then
        crate_name=1
        continue
    elif [[ "$crate_name" == "1" ]]; then
        if [[ "$i" == "tentris-server-rs" ]]; then
            set -- "$@" -C target-feature=+crt-static
            break
        fi
    fi
    crate_name=0
done

exec rustc "$@"
